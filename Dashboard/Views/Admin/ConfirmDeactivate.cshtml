@* Views/Admin/ConfirmDeactivate.cshtml *@
@* FRONTEND ONLY — placeholder data, works for both teacher and student *@
@{
    Layout = null;
    ViewData["Title"] = "Confirm Deactivate";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container py-4" style="max-width: 480px;">

        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white fw-semibold">
                Confirm Deactivation
            </div>
            <div class="card-body">

                <p class="mb-3">You are about to deactivate the following account:</p>

                @* Account summary — values will come from DB later *@
                <table class="table table-bordered table-sm mb-4">
                    <tr>
                        <th class="w-40">Teacher ID / LRN</th>
                        <td>2</td>
                    </tr>
                    <tr>
                        <th>Name</th>
                        <td>Maria Santos</td>
                    </tr>
                    <tr>
                        <th>Username</th>
                        <td>teacher01</td>
                    </tr>
                    <tr>
                        <th>Type</th>
                        <td>Teacher</td>
                    </tr>
                </table>

                <p class="text-muted small mb-4">
                    This account will be moved to the <strong>Archive</strong>.
                    It can be reactivated or permanently deleted from there.
                </p>

                <div class="d-flex gap-2">
                    @* Will become a POST form when backend is wired *@
                    <a href="/Admin/Index" class="btn btn-danger w-50">Confirm Deactivate</a>
                    <a href="/Admin/Index" class="btn btn-outline-secondary w-50">Cancel</a>
                </div>

            </div>
        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
