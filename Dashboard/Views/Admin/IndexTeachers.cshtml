@* Views/Admin/IndexTeachers.cshtml *@
@* FRONTEND ONLY — hardcoded placeholder data *@
@{
    Layout = null;
    ViewData["Title"] = "Admin - Active Accounts";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container py-4">

        @* ── Page header ──────────────────────────────────────────────── *@
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Admin Dashboard</h4>
            <a href="/Login/Logout" class="btn btn-outline-danger btn-sm">Log Out</a>
        </div>

        @* ── Active / Archive nav tabs ────────────────────────────────── *@
        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <a class="nav-link active" href="/Admin/Index">Active Accounts</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/Admin/Archive">Archive</a>
            </li>
        </ul>

        @* ══ TEACHERS TABLE ═══════════════════════════════════════════════ *@
        <h5 class="mb-2 fw-semibold">Teachers</h5>
        <div class="card shadow-sm mb-4">
            <div class="card-body p-0">
                <table class="table table-hover table-bordered mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Teacher ID</th>
                            <th>Name</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>Juan dela Cruz</td>
                            <td>admin01</td>
                            <td><span class="badge bg-danger">admin</span></td>
                            <td class="text-center">
                                <a href="/Admin/EditTeacher/1" class="btn btn-warning btn-sm me-1">Edit</a>
                                <a href="/Admin/ConfirmDeactivate?type=teacher&id=1" class="btn btn-outline-danger btn-sm">Deactivate</a>
                            </td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td>Maria Santos</td>
                            <td>teacher01</td>
                            <td><span class="badge bg-primary">teacher</span></td>
                            <td class="text-center">
                                <a href="/Admin/EditTeacher/2" class="btn btn-warning btn-sm me-1">Edit</a>
                                <a href="/Admin/ConfirmDeactivate?type=teacher&id=2" class="btn btn-outline-danger btn-sm">Deactivate</a>
                            </td>
                        </tr>
                        <tr>
                            <td>3</td>
                            <td>Pedro Reyes</td>
                            <td>teacher02</td>
                            <td><span class="badge bg-primary">teacher</span></td>
                            <td class="text-center">
                                <a href="/Admin/EditTeacher/3" class="btn btn-warning btn-sm me-1">Edit</a>
                                <a href="/Admin/ConfirmDeactivate?type=teacher&id=3" class="btn btn-outline-danger btn-sm">Deactivate</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        @* ══ STUDENTS TABLE ═══════════════════════════════════════════════ *@
        <h5 class="mb-2 fw-semibold">Students</h5>
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover table-bordered mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>LRN</th>
                            <th>Name</th>
                            <th>Username</th>
                            <th>Assigned Teacher</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>123456789001</td>
                            <td>Jose Rizal</td>
                            <td>student01</td>
                            <td>Maria Santos</td>
                            <td class="text-center">
                                <a href="/Admin/EditStudent/123456789001" class="btn btn-warning btn-sm me-1">Edit</a>
                                <a href="/Admin/ConfirmDeactivate?type=student&id=123456789001" class="btn btn-outline-danger btn-sm">Deactivate</a>
                            </td>
                        </tr>
                        <tr>
                            <td>123456789002</td>
                            <td>Andres Bonifacio</td>
                            <td>student02</td>
                            <td>Pedro Reyes</td>
                            <td class="text-center">
                                <a href="/Admin/EditStudent/123456789002" class="btn btn-warning btn-sm me-1">Edit</a>
                                <a href="/Admin/ConfirmDeactivate?type=student&id=123456789002" class="btn btn-outline-danger btn-sm">Deactivate</a>
                            </td>
                        </tr>
                        <tr>
                            <td>123456789003</td>
                            <td>Gabriela Silang</td>
                            <td>student03</td>
                            <td>Maria Santos</td>
                            <td class="text-center">
                                <a href="/Admin/EditStudent/123456789003" class="btn btn-warning btn-sm me-1">Edit</a>
                                <a href="/Admin/ConfirmDeactivate?type=student&id=123456789003" class="btn btn-outline-danger btn-sm">Deactivate</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
