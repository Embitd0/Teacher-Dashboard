@* Views/Admin/Archive.cshtml *@
@* FRONTEND ONLY — Archive view with Students (default) and Teachers tabs *@
@{
    Layout = null;
    ViewData["Title"] = "Admin - Archive";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container py-4">

        @* ── Header ───────────────────────────────────────────────────── *@
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <a href="/Admin/Index" class="text-decoration-none text-muted small">← Main Menu</a>
                <h4 class="mb-0 mt-1">Archive</h4>
            </div>
            <a href="/Login/Logout" class="btn btn-outline-danger btn-sm">Log Out</a>
        </div>

        @* ── Students / Teachers tab buttons ─────────────────────────── *@
        <div class="mb-3">
            <button class="btn btn-secondary me-2" id="btnStudents"
                    onclick="showTab('students')">
                Students
            </button>
            <button class="btn btn-outline-secondary" id="btnTeachers"
                    onclick="showTab('teachers')">
                Teachers
            </button>
        </div>

        @* ══ ARCHIVED STUDENTS (default visible) ══════════════════════════ *@
        <div id="tabStudents">
            <div class="card shadow-sm mb-4">
                <div class="card-body p-0">
                    <table class="table table-hover table-bordered mb-0 align-middle">
                        <thead class="table-secondary">
                            <tr>
                                <th>Student ID</th>
                                <th>Name</th>
                                <th>Username</th>
                                <th>Assigned Teacher</th>
                                <th>Archived At</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1002</td>
                                <td>Gabriela Silang</td>
                                <td>student02</td>
                                <td>Maria Santos</td>
                                <td>Feb 20, 2026 02:15 PM</td>
                                <td class="text-center">
                                    <a href="/Admin/ActiveAccounts" class="btn btn-success btn-sm me-1">Reactivate</a>
                                    <a href="#" class="btn btn-danger btn-sm"
                                       onclick="return confirm('Permanently delete Gabriela Silang? This cannot be undone.')">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                            @* Empty state — uncomment when no archived students
                        <tr>
                            <td colspan="6" class="text-center text-muted py-3">No archived students.</td>
                        </tr>
                        *@
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* ══ ARCHIVED TEACHERS (hidden by default) ════════════════════════ *@
        <div id="tabTeachers" style="display:none;">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover table-bordered mb-0 align-middle">
                        <thead class="table-secondary">
                            <tr>
                                <th>Teacher ID</th>
                                <th>Name</th>
                                <th>Username</th>
                                <th>Archived At</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>3</td>
                                <td>Ana Gomez</td>
                                <td>teacher03</td>
                                <td>Feb 18, 2026 10:00 AM</td>
                                <td class="text-center">
                                    <a href="/Admin/ActiveTeachers" class="btn btn-success btn-sm me-1">Reactivate</a>
                                    <a href="#" class="btn btn-danger btn-sm"
                                       onclick="return confirm('Permanently delete Ana Gomez? This cannot be undone.')">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                            @* Empty state — uncomment when no archived teachers
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">No archived teachers.</td>
                        </tr>
                        *@
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

    <script>
        function showTab(tab) {
            const studentsTab  = document.getElementById('tabStudents');
            const teachersTab  = document.getElementById('tabTeachers');
            const btnStudents  = document.getElementById('btnStudents');
            const btnTeachers  = document.getElementById('btnTeachers');

            if (tab === 'students') {
                studentsTab.style.display  = '';
                teachersTab.style.display  = 'none';
                btnStudents.className = 'btn btn-secondary me-2';
                btnTeachers.className = 'btn btn-outline-secondary';
            } else {
                studentsTab.style.display  = 'none';
                teachersTab.style.display  = '';
                btnStudents.className = 'btn btn-outline-secondary me-2';
                btnTeachers.className = 'btn btn-secondary';
            }
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
