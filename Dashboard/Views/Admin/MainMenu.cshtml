@* Views/Admin/MainMenu.cshtml *@
@* FRONTEND ONLY — main menu landing page after admin login *@
@{
    Layout = null;
    ViewData["Title"] = "Admin - Main Menu";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h3 class="mb-0">Admin Dashboard</h3>
                <span class="text-muted small">Welcome, System Administrator</span>
            </div>
            <a href="/Login/Logout" class="btn btn-outline-danger btn-sm">Log Out</a>
        </div>

        @* ── Main menu buttons ────────────────────────────────────────── *@
        <div class="row justify-content-center g-4">
            <div class="col-md-4">
                <a href="/Admin/ActiveAccounts" class="text-decoration-none">
                    <div class="card shadow text-center py-5 h-100 border-primary">
                        <div class="card-body">
                            <div class="fs-1 mb-3">👥</div>
                            <h5 class="card-title fw-bold text-primary">Active Accounts</h5>
                            <p class="card-text text-muted small">
                                View and manage all active student and teacher accounts.
                            </p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a href="/Admin/Archive" class="text-decoration-none">
                    <div class="card shadow text-center py-5 h-100 border-secondary">
                        <div class="card-body">
                            <div class="fs-1 mb-3">🗄️</div>
                            <h5 class="card-title fw-bold text-secondary">Archive</h5>
                            <p class="card-text text-muted small">
                                View deactivated accounts. Reactivate or permanently delete them.
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
