@* Views/Admin/ActiveTeachers.cshtml *@
@* FRONTEND ONLY — Teachers active accounts *@
@{
    Layout = null;
    ViewData["Title"] = "Admin - Active Accounts";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container py-4">

        @* ── Header ───────────────────────────────────────────────────── *@
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <a href="/Admin/Index" class="text-decoration-none text-muted small">← Main Menu</a>
                <h4 class="mb-0 mt-1">Active Accounts</h4>
            </div>
            <a href="/Login/Logout" class="btn btn-outline-danger btn-sm">Log Out</a>
        </div>

        @* ── Students / Teachers tab buttons ─────────────────────────── *@
        <div class="mb-3">
            <a href="/Admin/ActiveAccounts"
               class="btn btn-outline-primary me-2">
                Students
            </a>
            <a href="/Admin/ActiveTeachers"
               class="btn btn-primary">
                Teachers
            </a>
        </div>

        @* ── Teachers table ───────────────────────────────────────────── *@
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover table-bordered mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Teacher ID</th>
                            <th>Name</th>
                            <th>Username</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* Hardcoded rows — replace with @foreach from DB later *@
                        <tr>
                            <td>1</td>
                            <td>Maria Santos</td>
                            <td>teacher01</td>
                            <td class="text-center">
                                <a href="/Admin/EditTeacher/1" class="btn btn-warning btn-sm me-1">Edit</a>
                                <a href="/Admin/ConfirmDeactivate?type=teacher&id=1" class="btn btn-outline-danger btn-sm">Deactivate</a>
                            </td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td>Pedro Reyes</td>
                            <td>teacher02</td>
                            <td class="text-center">
                                <a href="/Admin/EditTeacher/2" class="btn btn-warning btn-sm me-1">Edit</a>
                                <a href="/Admin/ConfirmDeactivate?type=teacher&id=2" class="btn btn-outline-danger btn-sm">Deactivate</a>
                            </td>
                        </tr>
                        <tr>
                            <td>3</td>
                            <td>Ana Gomez</td>
                            <td>teacher03</td>
                            <td class="text-center">
                                <a href="/Admin/EditTeacher/3" class="btn btn-warning btn-sm me-1">Edit</a>
                                <a href="/Admin/ConfirmDeactivate?type=teacher&id=3" class="btn btn-outline-danger btn-sm">Deactivate</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
