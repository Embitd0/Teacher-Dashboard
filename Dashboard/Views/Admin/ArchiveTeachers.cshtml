@* Views/Admin/ArchiveTeachers.cshtml *@
@* FRONTEND ONLY — hardcoded placeholder data *@
@{
    Layout = null;
    ViewData["Title"] = "Admin - Archive";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container py-4">

        @* ── Page header ──────────────────────────────────────────────── *@
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Admin Dashboard</h4>
            <a href="/Login/Logout" class="btn btn-outline-danger btn-sm">Log Out</a>
        </div>

        @* ── Active / Archive nav tabs ────────────────────────────────── *@
        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <a class="nav-link" href="/Admin/Index">Active Accounts</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="/Admin/Archive">Archive</a>
            </li>
        </ul>

        @* ══ ARCHIVED TEACHERS ════════════════════════════════════════════ *@
        <h5 class="mb-2 fw-semibold">Teachers</h5>
        <div class="card shadow-sm mb-4">
            <div class="card-body p-0">
                <table class="table table-hover table-bordered mb-0 align-middle">
                    <thead class="table-secondary">
                        <tr>
                            <th>Teacher ID</th>
                            <th>Name</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Archived At</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>2</td>
                            <td>Maria Santos</td>
                            <td>teacher01</td>
                            <td><span class="badge bg-primary">teacher</span></td>
                            <td>Feb 24, 2026 10:30 AM</td>
                            <td class="text-center">
                                <a href="/Admin/Index" class="btn btn-success btn-sm me-1">Reactivate</a>
                                <a href="#" class="btn btn-danger btn-sm"
                                   onclick="return confirm('Permanently delete Maria Santos? This cannot be undone.')">
                                    Delete
                                </a>
                            </td>
                        </tr>
                        @* Empty state — uncomment when no archived teachers *@
                        @*
                    <tr>
                        <td colspan="6" class="text-center text-muted py-3">No archived teachers.</td>
                    </tr>
                    *@
                    </tbody>
                </table>
            </div>
        </div>

        @* ══ ARCHIVED STUDENTS ════════════════════════════════════════════ *@
        <h5 class="mb-2 fw-semibold">Students</h5>
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover table-bordered mb-0 align-middle">
                    <thead class="table-secondary">
                        <tr>
                            <th>LRN</th>
                            <th>Name</th>
                            <th>Username</th>
                            <th>Archived At</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>123456789002</td>
                            <td>Andres Bonifacio</td>
                            <td>student02</td>
                            <td>Feb 20, 2026 02:15 PM</td>
                            <td class="text-center">
                                <a href="/Admin/Index" class="btn btn-success btn-sm me-1">Reactivate</a>
                                <a href="#" class="btn btn-danger btn-sm"
                                   onclick="return confirm('Permanently delete Andres Bonifacio? This cannot be undone.')">
                                    Delete
                                </a>
                            </td>
                        </tr>
                        @*
                    <tr>
                        <td colspan="5" class="text-center text-muted py-3">No archived students.</td>
                    </tr>
                    *@
                    </tbody>
                </table>
            </div>
        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
