@* Views/Login/Index.cshtml *@
@model Dashboard.Models.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Teacher's Sanctuary</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />

    <style>
        :root {
            --gold-bg: #d4af37;
            --gold-border: #f9e27d;
            --blue-bg: #2a5a70;
            --blue-outline: #3a7a98;
            --panel-bg: rgba(13, 33, 53, 0.92);
            --text-cyan: #5ce1e6;
            --text-white: #e0f7fa;
            --dark-bg: #05161d;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Press Start 2P', cursive;
            height: 100vh;
            display: flex;
            overflow: hidden;
        }

        /* ── LEFT PANEL — Client branding ───────────────────────────── */
        .left-panel {
            width: 50%;
            background-color: #FFFFFF;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px 40px;
            position: relative;
            border-right: 6px solid var(--gold-border);
        }

            /* Gold accent strip along the top */
            .left-panel::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 6px;
                background: linear-gradient(to right, var(--gold-bg), var(--gold-border));
            }

        /* Client logo — no frame, just the image */
        .client-logo {
            width: 180px;
            margin-bottom: 30px;
        }

        .client-name {
            font-size: 15px;
            color: #1a1a2e;
            text-align: center;
            line-height: 2;
            letter-spacing: 2px;
            margin-bottom: 16px;
        }

        .client-tagline {
            font-size: 7px;
            color: #888;
            text-align: center;
            line-height: 2;
            letter-spacing: 1px;
            max-width: 260px;
        }

        /* ── RIGHT PANEL — Login form ────────────────────────────────── */
        .right-panel {
            width: 50%;
            background-color: var(--dark-bg);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px 40px;
        }

        .header-container {
            border: 6px solid var(--gold-border);
            background-color: rgba(10, 25, 41, 0.9);
            padding: 12px 30px;
            border-radius: 40px;
            margin-bottom: 35px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.8);
            text-align: center;
        }

            .header-container h1 {
                color: var(--text-cyan);
                font-size: 1rem;
                margin: 0;
                text-shadow: 2px 2px #000;
            }

        .login-box {
            background: var(--panel-bg);
            border: 3px solid var(--gold-bg);
            border-radius: 15px;
            padding: 35px 40px;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 0 30px rgba(0,0,0,0.6);
        }

            .login-box h2 {
                text-align: center;
                font-size: 13px;
                letter-spacing: 2px;
                margin-bottom: 28px;
                color: white;
            }

        .validation-summary-valid {
            display: none;
        }

        .validation-summary-errors {
            background: rgba(255, 50, 50, 0.15);
            border: 2px solid #ff5555;
            border-radius: 8px;
            padding: 10px 15px;
            margin-bottom: 18px;
            font-size: 8px;
            color: #ff5555;
            line-height: 1.8;
            list-style: none;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-size: 8px;
            color: var(--gold-border);
            margin-bottom: 8px;
            letter-spacing: 1px;
        }

        input[type="text"],
        input[type="password"] {
            width: 100%;
            background: rgba(0, 0, 0, 0.4);
            border: 2px solid var(--blue-outline);
            border-radius: 6px;
            color: var(--text-white);
            font-family: 'Press Start 2P', cursive;
            font-size: 8px;
            padding: 10px 12px;
            outline: none;
            transition: border-color 0.2s;
        }

        input:focus {
            border-color: var(--gold-border);
        }

        input.input-validation-error {
            border-color: #ff5555;
        }

        .field-validation-error {
            display: block;
            color: #ff5555;
            font-size: 7px;
            margin-top: 5px;
            line-height: 1.5;
        }

        .field-validation-valid {
            display: none;
        }

        .submit-btn {
            width: 100%;
            background-color: var(--blue-bg);
            border: 3px solid var(--gold-border);
            color: white;
            font-family: 'Press Start 2P', cursive;
            font-size: 10px;
            padding: 13px;
            border-radius: 10px;
            cursor: pointer;
            transition: 0.2s;
            letter-spacing: 1px;
            margin-top: 5px;
        }

            .submit-btn:hover {
                background-color: var(--blue-outline);
                transform: scale(1.02);
            }

        /* Stack vertically on small screens */
        @@media (max-width: 768px) {
            body {
                flex-direction: column;
                height: auto;
                overflow: auto;
            }

            .left-panel,
            .right-panel {
                width: 100%;
                padding: 40px 24px;
            }

            .left-panel {
                border-right: none;
                border-bottom: 6px solid var(--gold-border);
            }
        }
    </style>
</head>
<body>

    @* ── LEFT PANEL ───────────────────────────────────────────────────── *@
    <div class="left-panel">

        @* Palitan ang src ng tamang path ng iyong logo PNG *@
        <img src="~/images/ICONgslc.jpg" alt="Client Logo" class="client-logo" />

        @* Placeholder client name — palitan ng tunay na pangalan *@
        <p class="client-name">GOOD SHEPHERD LEARNING CENTER<br /></p>

        @* Placeholder tagline *@
        <p class="client-tagline">An overview of the GSLC Gamified Learning System, featuring a database preview of students currently participating in the platform.</p>

    </div>

    @* ── RIGHT PANEL ──────────────────────────────────────────────────── *@
    <div class="right-panel">

        <div class="header-container">
            <h1>TEACHER'S DASHBOARD</h1>
        </div>

        <div class="login-box">
            <h2>LOGIN</h2>

            <div asp-validation-summary="All" class="validation-summary-errors"></div>

            <form asp-action="Index" asp-controller="Login" method="post">

                <div class="form-group">
                    <label asp-for="Username"></label>
                    <input asp-for="Username" type="text" placeholder="E.G. TEACHER01" autocomplete="username" />
                    <span asp-validation-for="Username"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" placeholder="YOUR PASSWORD" autocomplete="current-password" />
                    <span asp-validation-for="Password"></span>
                </div>

                <button type="submit" class="submit-btn">&#9658; LOGIN</button>

            </form>
        </div>

    </div>

    @* Inlined — @section Scripts hindi gumagana kapag Layout = null *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
