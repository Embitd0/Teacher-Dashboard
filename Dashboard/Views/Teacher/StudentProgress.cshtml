@* Views/Teacher/StudentProgress.cshtml *@
@model Dashboard.Models.TeacherModel

@{
    Layout = null;
    ViewData["Title"] = "Student Progress";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

    <style>
        :root {
            --gold-primary: #d4af37;
            --gold-border: #f9e27d;
            --bg-dark-blue: #2a5a70;
            --table-overlay: rgba(13, 33, 53, 0.85);
            --text-cyan: #5ce1e6;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Press Start 2P', cursive;
            background-color: #05161d;
            color: white;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow-y: auto; /* allow page scroll only if screen is too short */
        }

        /* ── Header ─────────────────────────────────────────────────── */
        .header-container {
            flex-shrink: 0; /* hindi mag-s-shrink kahit maliit ang screen */
            margin-top: 30px;
            border: 6px solid var(--gold-border);
            background-color: rgba(10, 25, 41, 0.9);
            padding: 15px 50px;
            border-radius: 40px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.8);
        }

            .header-container h1 {
                color: var(--text-cyan);
                font-size: 22px;
                margin: 0;
                text-shadow: 2px 2px #000;
            }

        /* ── Content box ─────────────────────────────────────────────── */
        .content-box {
            flex-shrink: 0;
            margin-top: 25px;
            margin-bottom: 80px; /* space para sa logout button */
            width: 85%;
            max-width: 900px;
            background-color: var(--table-overlay);
            border: 3px solid var(--gold-primary);
            border-radius: 15px;
            padding: 25px 30px;
            /* No fixed height — the box grows/shrinks with the table content.
                       The table-wrapper's max-height controls when scrolling kicks in. */
            display: flex;
            flex-direction: column;
        }

            .content-box h2 {
                flex-shrink: 0; /* laging visible, hindi natatakpan ng scroll */
                text-align: center;
                font-size: 14px;
                margin-bottom: 20px;
                letter-spacing: 2px;
            }

        /* ── Scrollable table wrapper ────────────────────────────────── */
        .table-wrapper {
            overflow-x: auto;
            /* max-height — kung lumagpas ang rows dito, mag-a-appear ang scrollbar.
                       Calculated as: 1 row = ~44px + 55px thead = ~6 rows before scroll kicks in.
                       Adjust max-height kung gusto mong mas marami o mas kaunti bago mag-scroll. */
            max-height: 320px;
            /* overflow-y: auto — scrollbar appears ONLY when content exceeds max-height,
                       wala itong scrollbar kung kakaunti lang ang rows */
            overflow-y: auto;
            /* Custom scrollbar styling para match ang dark theme */
            scrollbar-width: thin;
            scrollbar-color: var(--gold-primary) rgba(255,255,255,0.05);
        }

            /* Webkit scrollbar (Chrome, Edge) */
            .table-wrapper::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            .table-wrapper::-webkit-scrollbar-track {
                background: rgba(255,255,255,0.05);
                border-radius: 10px;
            }

            .table-wrapper::-webkit-scrollbar-thumb {
                background: var(--gold-primary);
                border-radius: 10px;
            }

        /* ── Table styles ────────────────────────────────────────────── */
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }

        thead {
            /* Sticky header — nananatili sa taas kahit mag-scroll pababa */
            position: sticky;
            top: 0;
            z-index: 1;
            background-color: rgba(10, 25, 41, 0.98); /* opaque para hindi ma-overlap ng rows */
        }

        th {
            text-align: left;
            padding: 15px 10px; /* equal padding top and bottom — centered na ang text */
            color: var(--gold-border);
            border-bottom: 2px solid rgba(255, 255, 255, 0.3);
            white-space: nowrap;
        }

        td {
            padding: 13px 10px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            white-space: nowrap;
        }

        /* Subtle hover highlight on rows */
        tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.04);
        }

        /* ── View button (placeholder — wires up later) ──────────────── */
        .view-btn {
            background: none;
            border: none;
            color: white;
            text-decoration: underline;
            cursor: pointer;
            font-family: 'Press Start 2P', cursive;
            font-size: 9px;
            padding: 5px;
        }

            .view-btn:hover {
                color: var(--gold-border);
            }

        /* ── Back / Logout button ────────────────────────────────────── */
        .logout-btn {
            position: fixed;
            bottom: 25px;
            right: 35px;
            background-color: var(--bg-dark-blue);
            border: 3px solid var(--gold-border);
            color: white;
            padding: 10px 15px;
            font-family: 'Press Start 2P', cursive;
            font-size: 10px;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            transition: 0.2s;
        }

            .logout-btn:hover {
                background-color: #3a7a98;
                transform: scale(1.03);
            }
    </style>
</head>
<body>

    <div class="header-container">
        <h1>TEACHER'S DASHBOARD</h1>
    </div>

    <div class="content-box">
        <h2>STUDENT PROGRESS</h2>

        @*
            .table-wrapper — ito ang scrollable container.
            Ang <thead> ay sticky sa loob nito para palaging
            visible ang column headers kahit mag-scroll pababa.
        *@
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>NAME</th>
                        <th>COMPL. TASKS</th>
                        <th>ONG. TASKS</th>
                        <th>LEVEL</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody id="student-table-body">
                    @* Rows are populated by the JS below.
                       Palitan ng server-side Razor loop kapag
                       naka-connect na ang DB. *@
                </tbody>
            </table>
        </div>
    </div>

    @* Back to home — hindi logout, para makabalik sa main menu *@
    <a asp-controller="Teacher" asp-action="Home" class="logout-btn">&#9664; BACK</a>

    <script>
        // Hardcoded sample data — palitan ito ng actual DB values later
        const students = [
            { id: 101, name: "RIZAL, J.",      completed: 2, ongoing: 2, level: 1 },
            { id: 102, name: "BONIFACIO, A.",  completed: 1, ongoing: 2, level: 1 },
            { id: 103, name: "TALIS, J.",      completed: 4, ongoing: 1, level: 3 },
            { id: 104, name: "MARS, B.",       completed: 1, ongoing: 1, level: 1 },
            { id: 105, name: "BARNEY, B.",     completed: 0, ongoing: 2, level: 1 },
            { id: 106, name: "LUNA, A.",       completed: 3, ongoing: 0, level: 2 },
            { id: 107, name: "DEL PILAR, M.",  completed: 2, ongoing: 3, level: 2 },
            { id: 108, name: "MABINI, A.",     completed: 5, ongoing: 0, level: 4 },
            { id: 109, name: "AGUINALDO, E.",  completed: 1, ongoing: 2, level: 1 },
            { id: 110, name: "SILANG, D.",     completed: 3, ongoing: 1, level: 2 },
            { id: 111, name: "LAPU-LAPU",      completed: 6, ongoing: 0, level: 5 },
            { id: 112, name: "TANDANG SORA",   completed: 0, ongoing: 1, level: 1 },
        ];

        function renderTable(data) {
            const tableBody = document.getElementById('student-table-body');
            tableBody.innerHTML = '';

            data.forEach(student => {
                const row = `
                    <tr>
                        <td>${student.name}</td>
                        <td>${student.completed}</td>
                        <td>${student.ongoing}</td>
                        <td>${student.level}</td>
                        <td>
                            <button class="view-btn" onclick="viewStudent(${student.id})">VIEW</button>
                        </td>
                    </tr>
                `;
                tableBody.innerHTML += row;
            });
        }

        function viewStudent(id) {
            window.location.href = `/Teacher/ViewStudent?id=${id}`;
        }

        renderTable(students);
    </script>

</body>
</html>
