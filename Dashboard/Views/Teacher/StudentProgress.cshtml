@* Views/Teacher/StudentProgress.cshtml *@
@model IEnumerable<Dashboard.Models.Student>

@{
    Layout = null;
    ViewData["Title"] = "Student Progress";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

    <style>
        :root {
            --gold-primary: #d4af37;
            --gold-border: #f9e27d;
            --bg-dark-blue: #2a5a70;
            --table-overlay: rgba(13, 33, 53, 0.85);
            --text-cyan: #5ce1e6;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Press Start 2P', cursive;
            background-color: #05161d;
            color: white;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow-y: auto;
        }

        .header-container {
            flex-shrink: 0;
            margin-top: 30px;
            border: 6px solid var(--gold-border);
            background-color: rgba(10, 25, 41, 0.9);
            padding: 15px 50px;
            border-radius: 40px;
            box-shadow: 0 0 20px rgba(0,0,0,0.8);
        }

            .header-container h1 {
                color: var(--text-cyan);
                font-size: 22px;
                margin: 0;
                text-shadow: 2px 2px #000;
            }

        .content-box {
            flex-shrink: 0;
            margin-top: 25px;
            margin-bottom: 80px;
            width: 85%;
            max-width: 900px;
            background-color: var(--table-overlay);
            border: 3px solid var(--gold-primary);
            border-radius: 15px;
            padding: 25px 30px;
            display: flex;
            flex-direction: column;
        }

            .content-box h2 {
                flex-shrink: 0;
                text-align: center;
                font-size: 14px;
                margin-bottom: 20px;
                letter-spacing: 2px;
            }

        .table-wrapper {
            overflow-x: auto;
            max-height: 320px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: var(--gold-primary) rgba(255,255,255,0.05);
        }

            .table-wrapper::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            .table-wrapper::-webkit-scrollbar-track {
                background: rgba(255,255,255,0.05);
                border-radius: 10px;
            }

            .table-wrapper::-webkit-scrollbar-thumb {
                background: var(--gold-primary);
                border-radius: 10px;
            }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }

        thead {
            position: sticky;
            top: 0;
            z-index: 1;
            background-color: rgba(10, 25, 41, 0.98);
        }

        th {
            text-align: left;
            padding: 15px 10px;
            color: var(--gold-border);
            border-bottom: 2px solid rgba(255,255,255,0.3);
            white-space: nowrap;
        }

        td {
            padding: 13px 10px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            white-space: nowrap;
        }

        tbody tr:hover {
            background-color: rgba(255,255,255,0.04);
        }

        .view-btn {
            background: none;
            border: none;
            color: white;
            text-decoration: underline;
            cursor: pointer;
            font-family: 'Press Start 2P', cursive;
            font-size: 9px;
            padding: 5px;
        }

            .view-btn:hover {
                color: var(--gold-border);
            }

        .empty-state {
            text-align: center;
            color: rgba(255,255,255,0.4);
            font-size: 10px;
            padding: 30px 0;
        }

        .logout-btn {
            position: fixed;
            bottom: 25px;
            right: 35px;
            background-color: var(--bg-dark-blue);
            border: 3px solid var(--gold-border);
            color: white;
            padding: 10px 15px;
            font-family: 'Press Start 2P', cursive;
            font-size: 10px;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            transition: 0.2s;
        }

            .logout-btn:hover {
                background-color: #3a7a98;
                transform: scale(1.03);
            }
    </style>
</head>
<body>

    <div class="header-container">
        <h1>TEACHER'S DASHBOARD</h1>
    </div>

    <div class="content-box">
        <h2>STUDENT PROGRESS</h2>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>NAME</th>
                        <th>USERNAME</th>
                        <th>CAPABILITY LEVEL</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td>@student.Name</td>
                                <td>@student.Username</td>
                                <td>@student.CapabilityLevel</td>
                                <td>
                                    @* lrn is used as the route id since it's the PK *@
                                    <a asp-controller="Teacher"
                                       asp-action="ViewStudent"
                                       asp-route-id="@student.Lrn"
                                       class="view-btn">VIEW</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="empty-state">NO STUDENTS FOUND.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <a asp-controller="Teacher" asp-action="Home" class="logout-btn">&#9664; BACK</a>

</body>
</html>
