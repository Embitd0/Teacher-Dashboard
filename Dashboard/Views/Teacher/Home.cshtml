@* Views/Teacher/Home.cshtml *@
@* Isang linya lang ang binago mula sa original mo:
   ang LOG OUT card — nagtuturo na sa Login/Logout para ma-clear ang session *@

@model Dashboard.Models.TeacherModel
@{
    Layout = null;
    ViewData["Title"] = "Teacher's Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <style>
        :root {
            --gold-bg: #d4af37;
            --gold-border: #f9e27d;
            --blue-bg: #2a5a70;
            --text-white: #e0f7fa;
        }

        body {
            margin: 0;
            font-family: 'Press Start 2P', cursive;
            background-color: #05161d;
            overflow: hidden;
        }

        .sanctuary-container {
            height: 100vh;
            background: url('/images/teacher_sanctuary_bg.jpg') no-repeat center center;
            background-size: cover;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .main-title {
            border: 6px solid var(--gold-border);
            background-color: rgba(10, 25, 41, 0.9);
            padding: 15px 50px;
            border-radius: 40px;
            margin-bottom: 50px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.8);
        }

            .main-title h1 {
                color: #5ce1e6;
                margin: 0;
                font-size: 1.5rem;
                text-shadow: 2px 2px #000;
            }

        .menu-grid {
            display: flex;
            gap: 30px;
        }

        .card-link {
            text-decoration: none;
            color: inherit;
        }

        .card {
            width: 170px;
            height: 190px;
            border-radius: 15px;
            border: 3px solid rgba(255,255,255,0.3);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 15px;
            transition: 0.2s;
            cursor: pointer;
        }

            .card:hover {
                transform: scale(1.05);
                border-color: var(--gold-border);
            }

            .card.gold {
                background-color: var(--gold-bg);
            }

            .card.blue {
                background-color: var(--blue-bg);
            }

        .icon-circle {
            width: 75px;
            height: 75px;
            border-radius: 50%;
            border: 4px solid var(--gold-border);
            background: radial-gradient(circle, #0a2e38, #000);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card p {
            color: var(--text-white);
            font-size: 0.6rem;
            line-height: 1.4;
            margin: 0;
        }
    </style>
</head>
<body>
    <div class="sanctuary-container">
        <header class="main-title">
            <h1>TEACHER'S SANCTUARY</h1>
        </header>

        <div class="menu-grid">
            <a asp-controller="Teacher" asp-action="StudentProgress" class="card-link">
                <div class="card gold">
                    <div class="icon-circle">
                        <img src="~/images/ICONpreview.png" alt="Progress" width="40">
                    </div>
                    <p>VIEW CLASS PROGRESS</p>
                </div>
            </a>

            @* BINAGO: Login/Logout na para ma-clear ang session bago bumalik sa login page *@
            <a asp-controller="Login" asp-action="Logout" class="card-link">
                <div class="card blue">
                    <div class="icon-circle">
                        <img src="~/images/ICONlogout.png" alt="Log Out" width="40">
                    </div>
                    <p>LOG OUT</p>
                </div>
            </a>
        </div>
    </div>
</body>
</html>
