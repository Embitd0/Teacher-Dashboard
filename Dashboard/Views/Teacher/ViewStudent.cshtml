@model Dashboard.Models.Student
@using Dashboard.Models

@{
    Layout = null;
    ViewData["Title"] = "Student Profile";
    var scores = ViewBag.Scores as List<PuzzleQuestScore>;
    var badges = ViewBag.Badges as List<StudentBadge>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Teacher's Sanctuary</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <style>
        :root {
            --gold-border: #f9e27d;
            --blue-outline: #3a7a98;
            --panel-bg: rgba(13, 33, 53, 0.9);
            --text-cyan: #5ce1e6;
            --text-white: #e0f7fa;
        }

        body {
            margin: 0;
            font-family: 'Press Start 2P', cursive;
            background: #05161d;
            color: var(--text-white);
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .header-container {
            border: 6px solid var(--gold-border);
            background-color: rgba(10, 25, 41, 0.95);
            padding: 15px 60px;
            border-radius: 50px;
            margin-bottom: 30px;
            box-shadow: 0 0 15px rgba(0,0,0,0.5);
        }

            .header-container h1 {
                color: var(--text-cyan);
                font-size: 24px;
                margin: 0;
                text-align: center;
            }

        .profile-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            width: 95%;
            max-width: 1100px;
        }

        .panel {
            background: var(--panel-bg);
            border: 3px solid var(--blue-outline);
            border-radius: 15px;
            padding: 20px;
        }

        .panel-title {
            font-size: 12px;
            border-bottom: 2px solid rgba(255,255,255,0.2);
            padding-bottom: 12px;
            margin-bottom: 20px;
            text-align: center;
            color: white;
            letter-spacing: 1px;
        }

        .info-row {
            font-size: 10px;
            line-height: 1.8;
            margin-bottom: 8px;
        }

        .value {
            color: var(--text-cyan);
        }

        .empty-state {
            font-size: 9px;
            color: rgba(255,255,255,0.4);
            text-align: center;
            padding: 20px 0;
        }

        /* Scores */
        .scores-wrapper {
            overflow-x: auto;
            max-height: 200px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: var(--gold-border) rgba(255,255,255,0.05);
        }

            .scores-wrapper::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            .scores-wrapper::-webkit-scrollbar-track {
                background: rgba(255,255,255,0.05);
                border-radius: 10px;
            }

            .scores-wrapper::-webkit-scrollbar-thumb {
                background: var(--gold-border);
                border-radius: 10px;
            }

        .scores-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 8px;
        }

            .scores-table th {
                padding: 8px 6px;
                color: var(--gold-border);
                text-align: left;
                border-bottom: 2px solid rgba(255,255,255,0.2);
                white-space: nowrap;
            }

            .scores-table td {
                padding: 8px 6px;
                border-bottom: 1px solid rgba(255,255,255,0.08);
                white-space: nowrap;
            }

            .scores-table tbody tr:hover {
                background-color: rgba(255,255,255,0.04);
            }

            .scores-table .quest-id {
                color: var(--text-cyan);
            }

        /* Badges */
        .badges-wrapper {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            max-height: 200px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: var(--gold-border) rgba(255,255,255,0.05);
        }

            .badges-wrapper::-webkit-scrollbar {
                width: 6px;
            }

            .badges-wrapper::-webkit-scrollbar-track {
                background: rgba(255,255,255,0.05);
                border-radius: 10px;
            }

            .badges-wrapper::-webkit-scrollbar-thumb {
                background: var(--gold-border);
                border-radius: 10px;
            }

        .badge-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            width: 70px;
            position: relative;
            cursor: pointer;
        }

            .badge-item img {
                width: 32px;
                height: 32px;
                image-rendering: pixelated;
            }

            .badge-item span {
                font-size: 7px;
                text-align: center;
                color: var(--gold-border);
                word-break: break-word;
            }

        /* Tooltip for date earned */
        .badge-tooltip {
            visibility: hidden;
            opacity: 0;
            background-color: rgba(10, 25, 41, 0.95);
            border: 2px solid var(--gold-border);
            color: var(--text-white);
            font-size: 7px;
            text-align: center;
            padding: 6px 8px;
            border-radius: 6px;
            position: absolute;
            bottom: 110%;
            left: 50%;
            transform: translateX(-50%);
            white-space: nowrap;
            transition: opacity 0.2s;
            z-index: 10;
            pointer-events: none;
        }

        .badge-item:hover .badge-tooltip {
            visibility: visible;
            opacity: 1;
        }

        /* Footer */
        .footer-nav {
            width: 95%;
            max-width: 1100px;
            display: flex;
            justify-content: flex-end;
            margin-top: 20px;
        }

        .back-btn {
            background-color: #2a5a70;
            border: 3px solid var(--gold-border);
            color: white;
            padding: 12px 20px;
            font-family: 'Press Start 2P', cursive;
            font-size: 10px;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            transition: 0.2s;
        }

            .back-btn:hover {
                background-color: #3a7a98;
                transform: scale(1.05);
            }

        @@media (max-width: 800px) {
            .profile-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <div class="header-container">
        <h1>STUDENT PROFILE</h1>
    </div>

    @if (Model != null)
    {
        <div class="profile-grid">

            <div class="panel">
                <div class="panel-title">CHARACTER INFORMATION</div>
                <div class="info-row">STUDENT NAME: <span class="value">@Model.Name</span></div>
                <div class="info-row">USERNAME: <span class="value">@Model.Username</span></div>
                <div class="info-row">LRN: <span class="value">@Model.Lrn</span></div>
                <hr style="border:0; border-top:1px solid rgba(255,255,255,0.2); margin:15px 0;">
                <div class="info-row">CAPABILITY LEVEL: <span class="value">@Model.CapabilityLevel</span></div>
                <div class="info-row">SENSORY PROFILE: <span class="value">@Model.SensoryProfileSetting</span></div>
            </div>

            <div class="panel">
                <div class="panel-title">CURRENT ONGOING TASKS</div>
                <div class="empty-state">NOT YET STARTED.</div>
            </div>

            <div class="panel">
                <div class="panel-title">REWARDS AND BADGES</div>

                @if (badges != null && badges.Any())
                {
                    <div class="badges-wrapper">
                        @foreach (var b in badges)
                        {
                            <div class="badge-item">
                                <div class="badge-tooltip">EARNED: @b.DateEarned.ToString("MM/dd/yyyy")</div>
                                <img src="~/favicon.ico" alt="badge" />
                                <span>@(b.Badge?.Name ?? "UNKNOWN")</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">NO BADGES EARNED YET.</div>
                }
            </div>

            <div class="panel">
                <div class="panel-title">COMPLETED TASKS</div>

                @if (scores != null && scores.Any())
                {
                    <div class="scores-wrapper">
                        <table class="scores-table">
                            <thead>
                                <tr>
                                    <th>QUEST</th>
                                    <th>SCORE</th>
                                    <th>TIME</th>
                                    <th>COMPLETED</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in scores)
                                {
                                    <tr>
                                        <td class="quest-id">QUEST @s.QuestId</td>
                                        <td>@s.Score</td>
                                        <td>@s.TimeOnTaskSec s</td>
                                        <td>@s.DateCompleted.ToString("MM/dd/yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">NO COMPLETED TASKS YET.</div>
                }
            </div>

        </div>
    }
    else
    {
        <p style="font-size:12px; color:rgba(255,255,255,0.5);">STUDENT NOT FOUND.</p>
    }

    <div class="footer-nav">
        <a asp-controller="Teacher" asp-action="StudentProgress" class="back-btn">BACK TO CLASS VIEW</a>
    </div>

</body>
</html>