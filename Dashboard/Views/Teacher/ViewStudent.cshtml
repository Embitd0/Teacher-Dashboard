@* Views/Teacher/ViewStudent.cshtml *@
@model Dashboard.Models.Student

@{
    Layout = null;
    ViewData["Title"] = "Student Profile";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Teacher's Sanctuary</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <style>
        :root {
            --gold-border: #f9e27d;
            --blue-outline: #3a7a98;
            --panel-bg: rgba(13, 33, 53, 0.9);
            --text-cyan: #5ce1e6;
            --text-white: #e0f7fa;
        }

        body {
            margin: 0;
            font-family: 'Press Start 2P', cursive;
            background: #05161d;
            color: var(--text-white);
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .header-container {
            border: 6px solid var(--gold-border);
            background-color: rgba(10, 25, 41, 0.95);
            padding: 15px 60px;
            border-radius: 50px;
            margin-bottom: 30px;
            box-shadow: 0 0 15px rgba(0,0,0,0.5);
        }

            .header-container h1 {
                color: var(--text-cyan);
                font-size: 24px;
                margin: 0;
                text-align: center;
            }

        .profile-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            width: 95%;
            max-width: 1100px;
        }

        .panel {
            background: var(--panel-bg);
            border: 3px solid var(--blue-outline);
            border-radius: 15px;
            padding: 20px;
        }

        .panel-title {
            font-size: 12px;
            border-bottom: 2px solid rgba(255,255,255,0.2);
            padding-bottom: 12px;
            margin-bottom: 20px;
            text-align: center;
            color: white;
            letter-spacing: 1px;
        }

        .info-row {
            font-size: 10px;
            line-height: 1.8;
            margin-bottom: 8px;
        }

        .value {
            color: var(--text-cyan);
        }

        .empty-state {
            font-size: 9px;
            color: rgba(255,255,255,0.4);
            text-align: center;
            padding: 20px 0;
        }

        .footer-nav {
            width: 95%;
            max-width: 1100px;
            display: flex;
            justify-content: flex-end;
            margin-top: 20px;
        }

        .back-btn {
            background-color: #2a5a70;
            border: 3px solid var(--gold-border);
            color: white;
            padding: 12px 20px;
            font-family: 'Press Start 2P', cursive;
            font-size: 10px;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            transition: 0.2s;
        }

            .back-btn:hover {
                background-color: #3a7a98;
                transform: scale(1.05);
            }

        @@media (max-width: 800px) {
            .profile-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <div class="header-container">
        <h1>STUDENT PROFILE</h1>
    </div>

    @if (Model != null)
    {
        <div class="profile-grid">

            <div class="panel">
                <div class="panel-title">CHARACTER INFORMATION</div>
                <div class="info-row">STUDENT NAME: <span class="value">@Model.Name</span></div>
                <div class="info-row">USERNAME: <span class="value">@Model.Username</span></div>
                <div class="info-row">LRN: <span class="value">@Model.Lrn</span></div>
                <hr style="border:0; border-top:1px solid rgba(255,255,255,0.2); margin:15px 0;">
                <div class="info-row">CAPABILITY LEVEL: <span class="value">@Model.CapabilityLevel</span></div>
                <div class="info-row">SENSORY PROFILE: <span class="value">@Model.SensoryProfileSetting</span></div>
            </div>

            <div class="panel">
                <div class="panel-title">CURRENT ONGOING TASKS</div>
                <div class="empty-state">TASK DATA NOT YET CONNECTED.</div>
            </div>

            <div class="panel">
                <div class="panel-title">REWARDS AND BADGES</div>
                <div class="empty-state">BADGE DATA NOT YET CONNECTED.</div>
            </div>

            <div class="panel">
                <div class="panel-title">COMPLETED TASKS</div>
                <div class="empty-state">TASK DATA NOT YET CONNECTED.</div>
            </div>

        </div>
    }
    else
    {
        <p style="font-size:12px; color:rgba(255,255,255,0.5);">STUDENT NOT FOUND.</p>
    }

    <div class="footer-nav">
        <a asp-controller="Teacher" asp-action="StudentProgress" class="back-btn">BACK TO CLASS VIEW</a>
    </div>

</body>
</html>
