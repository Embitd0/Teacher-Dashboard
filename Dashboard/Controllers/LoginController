// Controllers/LoginController.cs
// Hawak nito ang login at logout.
// Hardcoded credentials lang muna — palitan ng DB query kapag ready ka na.

using Microsoft.AspNetCore.Mvc;
using Dashboard.Models;

namespace Dashboard.Controllers
{
    public class LoginController : Controller
    {
        // --- HARDCODED ACCOUNT ---
        // Palitan lang ang dalawang ito kapag nag-connect ka na sa database.
        private const string HardcodedUsername = "teacher01";
        private const string HardcodedPassword = "password123";

        // GET /Login — Pinakita ang login form
        [HttpGet]
        public IActionResult Index()
        {
            // Kung naka-login na, i-redirect agad sa dashboard
            if (HttpContext.Session.GetString("LoggedInUser") != null)
                return RedirectToAction("Home", "Teacher");

            return View(new LoginViewModel());
        }

        // POST /Login — Pinoproseso ang submitted form
        [HttpPost]
        [ValidateAntiForgeryToken] // Nagpoprotekta laban sa CSRF attacks
        public IActionResult Index(LoginViewModel model)
        {
            // Suriin kung pumasa ang Required validation bago mag-proceed
            if (!ModelState.IsValid)
                return View(model);

            // --- Credential check ---
            // TODO: Palitan ito ng DB lookup kapag ready ka na, hal.:
            //   var user = _db.Users.FirstOrDefault(u => u.Username == model.Username);
            //   if (user == null || !BCrypt.Verify(model.Password, user.PasswordHash)) { ... }
            bool isValid = model.Username == HardcodedUsername
                        && model.Password == HardcodedPassword;

            if (!isValid)
            {
                // General error — ipinakita sa asp-validation-summary ng view
                ModelState.AddModelError("", "INVALID USERNAME OR PASSWORD.");
                return View(model);
            }

            // I-save ang username sa session para malaman ng app na naka-login
            HttpContext.Session.SetString("LoggedInUser", model.Username);

            return RedirectToAction("Home", "Teacher");
        }

        // GET /Login/Logout — Burahin ang session at bumalik sa login
        public IActionResult Logout()
        {
            HttpContext.Session.Clear();
            return RedirectToAction("Index", "Login");
        }
    }
}